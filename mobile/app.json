{
  "expo": {
    "name": "AIルート",
    "slug": "yorimichi-route",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yorimichi",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地から出発するルートで、出発地として使います。"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yorimichi.route"
    },
    "android": {
      "package": "app.yorimichi.route",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "yorimichi" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
