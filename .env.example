# 各自コピーして .env を作る (.env はコミットされない)
# cp .env.example .env

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Google Maps / Places
# 注意: フロントに出るキーは必ず HTTP リファラ制限 + API制限をかける
GOOGLE_MAPS_API_KEY=

# リアルタイム同期 (Firebase / Supabase のどちらかに決めたら不要な方を消す)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
