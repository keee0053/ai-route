# 各自コピーして .env を作る (.env は gitignore 済み。絶対にコミットしない)
#   cp .env.example .env

# --- TypeSafe AI (Jev) ---
# https://console.typesafe.ai で発行
TYPESAFE_API_KEY=

# --- Google Maps Platform ---
# キーは2本に分ける。1本で兼用しない。

# サーバから叩く用: Routes API / Places API (New)
# 制限: アプリケーションの制限=なし(または IP制限)、API制限= Routes API, Places API (New)
GOOGLE_MAPS_SERVER_KEY=

# Androidアプリに埋める用: Maps SDK for Android
# 制限: アプリケーションの制限=Androidアプリ
#   パッケージ名 com.prizmprograms.ekz
#   SHA-1 (debug) E6:2A:B8:49:96:1E:18:E9:2F:B4:25:EF:7C:79:54:C9:66:41:0B:A5
#   API制限= Maps SDK for Android
GOOGLE_MAPS_ANDROID_KEY=
